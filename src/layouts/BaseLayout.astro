---
const {
  title = 'Rubén Seijo — Portfolio profesional',
  description = 'Portfolio profesional de Rubén Seijo: análisis funcional, diseño de soluciones y transformación digital.'
} = Astro.props;
const base = import.meta.env.BASE_URL;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
const path = Astro.url.pathname;
const nextCase = path.includes('/proyectos/pulse/')
  ? { label: 'Siguiente caso', title: 'CMMS 2.0', href: `${base}proyectos/cmms-2-0/` }
  : path.includes('/proyectos/cmms-2-0/')
    ? { label: 'Siguiente caso', title: 'Power BI Studio', href: `${base}proyectos/power-bi-studio/` }
    : path.includes('/proyectos/power-bi-studio/')
      ? { label: 'Volver al inicio', title: 'Ver los tres casos', href: `${base}#proyectos` }
      : null;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#f6f6f3" />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Portfolio profesional · Rubén Seijo" />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <title>{title}</title>
    <link rel="stylesheet" href={`${base}styles/global.css`} />
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <header class="site-header">
      <a class="brand" href={base} aria-label="Ir a la página de inicio">Rubén Seijo</a>
      <nav aria-label="Navegación principal">
        <a href={`${base}#proyectos`}>Proyectos</a>
        <a href={`${base}#sobre-mi`}>Sobre mí</a>
        <a href={`${base}#metodo`}>Cómo trabajo</a>
        <a href={`${base}#contacto`}>Contacto</a>
      </nav>
    </header>
    <main id="contenido">
      <slot />
      {nextCase && (
        <aside class="case-trail" aria-label="Continuar explorando el portfolio">
          <span>{nextCase.label}</span>
          <a href={nextCase.href}>{nextCase.title} <i aria-hidden="true">→</i></a>
        </aside>
      )}
    </main>
    <footer class="site-footer">
      <p>Portfolio profesional · Rubén Seijo</p>
    </footer>
  </body>
</html>

<style>
  .case-trail{margin:0 0 72px;padding:34px 0;border-top:1px solid #d9d9d4;border-bottom:1px solid #d9d9d4;display:flex;align-items:flex-end;justify-content:space-between;gap:24px}.case-trail span{font-size:.75rem;font-weight:800;letter-spacing:.1em;text-transform:uppercase;color:#6b6b72}.case-trail a{font-size:clamp(1.45rem,3vw,2.35rem);font-weight:800;letter-spacing:-.025em;line-height:1.05}.case-trail a:hover{text-decoration:underline;text-underline-offset:7px}.case-trail i{font-style:normal;margin-left:.25em}@media(max-width:600px){.case-trail{margin-bottom:44px;padding:28px 0;align-items:flex-start;flex-direction:column;gap:10px}}
</style>
