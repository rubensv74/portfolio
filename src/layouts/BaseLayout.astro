---
const {
  title = 'Rubén Seijo — Portfolio profesional',
  description = 'Portfolio profesional de Rubén Seijo: análisis funcional, diseño de soluciones y transformación digital.'
} = Astro.props;
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <link rel="stylesheet" href={`${base}styles/global.css`} />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href={base}>Rubén Seijo</a>
      <nav aria-label="Navegación principal">
        <a href={`${base}#sobre-mi`}>Sobre mí</a>
        <a href={`${base}#proyectos`}>Proyectos</a>
        <a href={`${base}#metodo`}>Cómo trabajo</a>
        <a href={`${base}#contacto`}>Contacto</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <p>Portfolio profesional · Rubén Seijo</p>
    </footer>
  </body>
</html>
