color:#be123c;font-weight:700}.selected-row{background:#f0fdf8}.flow-strip{display:flex;align-items:center;justify-content:center;gap:.65rem;flex-wrap:wrap;margin-top:1rem;color:#475569;font-size:.76rem;font-weight:700}.flow-strip span{padding:.5rem .65rem;border:1px solid #dbe3ea;border-radius:8px;background:#fff}.flow-strip i{font-style:normal;color:#94a3b8}.evolution-track{display:grid;grid-template-columns:repeat(4,1fr);gap:.75rem;margin-top:1.5rem}.evolution-card{position:relative;min-height:320px;padding:1.1rem;border:1px solid #dfe6ed;border-radius:16px;background:#fff}.evolution-card.mature{border-color:#9bd7bf;background:#f6fffb}.evolution-number{display:inline-flex;width:32px;height:32px;align-items:center;justify-content:center;border-radius:9px;background:#172a3d;color:#fff;font-size:.68rem;font-weight:900}.evolution-card.mature .evolution-number{background:#15805b}.evolution-label{margin:.9rem 0 .2rem;color:#15805b;font-size:.68rem;font-weight:800;text-transform:uppercase;letter-spacing:.08em}.evolution-card h3{margin:.1rem 0 .8rem;font-size:1rem}.evolution-card>p:not(.evolution-label){font-size:.8rem;color:#64748b}.evolution-card>strong{display:block;margin-top:.75rem;font-size:.76rem;color:#172a3d}.mini-table,.mini-dashboard,.mini-bars,.mini-review{height:70px;margin:.8rem 0 1rem;padding:.55rem;border-radius:9px;background:#f1f5f9}.mini-table{display:grid;gap:5px}.mini-table i{height:7px;border-radius:3px;background:#cbd5e1}.mini-dashboard{display:grid;grid-template-columns:repeat(3,1fr);gap:6px}.mini-dashboard i{height:20px;border-radius:5px;background:#b9c8d8}.mini-dashboard b{grid-column:1/-1;height:26px;border-radius:6px;background:#dce4ec}.mini-bars{display:grid;align-content:center;gap:6px}.mini-bars i{display:block;width:var(--mw);height:7px;border-radius:10px;background:#6f8faa}.mini-bars i:first-child{background:#36b37e}.mini-review{display:grid;grid-template-columns:34% 1fr;gap:8px}.mini-review>i{border-radius:6px;background:#b7c8d7}.mini-re