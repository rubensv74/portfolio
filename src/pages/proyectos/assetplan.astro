  .evolution-track{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:1px;margin-top:34px;background:#d7e0ea;border:1px solid #d7e0ea}.evolution-track article{background:#fff;padding:22px;min-height:230px}.evolution-track p{margin:22px 0 3px;font-size:.72rem;text-transform:uppercase;letter-spacing:.07em;color:#64748b;font-weight:750}.evolution-track h3{margin:0 0 18px}.evolution-track strong{font-size:.88rem;line-height:1.45;color:#4f6072}
  .learning-grid{display:grid;grid-template-columns:1.1fr .9fr;gap:48px;align-items:start;margin-top:30px}.learning-grid .tool-list{margin-top:0}
  @media(max-width:900px){.origin-card{grid-template-columns:1fr}.origin-card i{text-align:left;transform:rotate(90deg);width:24px}.discovery-grid,.product-grid,.evolution-track{grid-template-columns:repeat(2,minmax(0,1fr))}.value-chain{grid-template-columns:1fr}.value-chain>i{transform:rotate(90deg)}.ap-kpis{grid-template-columns:repeat(2,minmax(0,1fr))}.ap-panels{grid-template-columns:1fr}.learning-grid{grid-template-columns:1fr;gap:22px}}
  @media(max-width:680px){.visual-heading{flex-direction:column;gap:10px}.recreation-badge{align-self:flex-start}.discovery-grid,.product-grid,.evolution-track{grid-template-columns:1fr}.assetplan-frame{overflow-x:auto}.ap-topbar,.ap-body{min-width:760px}.flow-strip{justify-content:flex-start}.origin-card{padding:18px}.value-chain>div{padding:16px}.evolution-track article{min-height:auto}}
