  .origin-card span,.discovery-grid span,.product-grid span,.evolution-track span{font-size:.72rem;font-weight:850;letter-spacing:.1em;text-transform:uppercase;color:#1d4ed8}.origin-card strong{font-size:1.06rem;line-height:1.4}.origin-card i{font-style:normal;font-size:1.5rem;color:#2563eb;text-align:center}
  .discovery-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px;margin-top:34px}.discovery-grid article,.product-grid article{padding:22px;border:1px solid #d7e0ea;border-radius:16px;background:#fff;box-shadow:0 8px 22px rgba(15,23,42,.04)}.discovery-grid h3,.product-grid h3{margin-top:22px}.discovery-grid p,.product-grid p{margin-bottom:0;color:#526071}
  .value-chain{margin-top:34px;display:grid;grid-template-columns:repeat(11,auto);align-items:stretch;gap:9px}.value-chain>div{min-width:0;padding:20px 14px;border:1px solid #d2dfef;border-radius:14px;background:#fff;display:flex;flex-direction:column;gap:5px}.value-chain>div span{font-size:.7rem;font-weight:850;color:#2563eb}.value-chain>div strong{font-size:1rem}.value-chain>div small{font-size:.76rem;color:#64748b;line-height:1.3}.value-chain>i{align-self:center;font-style:normal;color:#7c9ac7}
  .product-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px;margin-top:34px}
  .visual-heading{display:flex;justify-content:space-between;gap:28px;align-items:flex-start}.recreation-badge{flex:0 0 auto;padding:7px 10px;border:1px solid #b8c9df;border-radius:999px;background:#f8fbff;color:#31557f;font-size:.72rem;font-weight:800}
  .assetplan-frame{margin-top:34px;border:1px solid #aebfd5;border-radius:18px;overflow:hidden;background:#edf3f8;box-shadow:0 24px 60px rgba(15,23,42,.12)}.ap-topbar{height:60px;background:#fff;border-bottom:1px solid #d9e2ec;display:grid;grid-template-columns:220px 1fr auto;align-items:center;padding:0 18px;gap:18px}.ap-brand{display:flex;align-items:center;gap:10px}.ap-brand>span{display:grid;place-items:center;width:30px;height:30px;border-radius:9px;background:#10243b;color:white;font-weight:850}.ap-brand strong{font-size:.95rem;color:#13243d}.ap-context{display:flex;align-items:baseline;gap:10px}.ap-context small{font-size:.68rem;text-transform:uppercase;letter-spacing:.08em;color:#64748b;font-weight:750}.ap-context strong{font-size:.9rem}.ap-context>span{padding:3px 7px;border-radius:999px;background:#eef4fb;color:#416181;font-size:.68rem;font-weight:750}.ap-topbar button,.ap-table-panel button{border:1px solid #a9bdd5;border-radius:9px;background:#fff;padding:8px 10px;font-weight:750;color:#214263}.ap-body{display:grid;grid-template-columns:160px 1fr;min-height:565px}.ap-sidebar{background:#10243b;color:#dce8f4;padding:18px 12px;display:flex;flex-direction:column;gap:5px}.ap-sidebar strong{font-size:.68rem;text-transform:uppercase;letter-spacing:.09em;color:#93adc7;padding:3px 10px 10px}.ap-sidebar span{padding:9px 10px;border-radius:8px;font-size:.8rem}.ap-sidebar .active{background:#1f3d5d;color:#fff;font-weight:750}.ap-workspace{padding:20px}.ap-heading{display:flex;justify-content:space-between;gap:20px;align-items:flex-end}.ap-heading>div{display:flex;flex-direction:column}.ap-heading small,.panel-title small{font-size:.68rem;color:#64748b;text-transform:uppercase;letter-spacing:.07em;font-weight:750}.ap-heading strong{font-size:1.15rem;color:#14273d}.ap-heading>span{font-size:.72rem;color:#64748b}.ap-kpis{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px;margin-top:16px}.ap-kpis article{background:#fff;border:1px solid #d7e0ea;border-radius:12px;padding:14px}.ap-kpis span{display:block;font-size:.7rem;color:#64748b}.ap-kpis strong{display:block;font-size:1.6rem;line-height:1.2;margin:7px 0 4px;color:#13243d}.ap-kpis small{font-size:.68rem;color:#8090a1}.ap-panels{display:grid;grid-template-columns:1.1fr .9fr;gap:10px;margin-top:10px}.ap-panel{background:#fff;border:1px solid #d7e0ea;border-radius:12px;padding:14px}.panel-title{display:flex;justify-content:space-between;gap:18px;align-items:center}.panel-title>div{display:flex;flex-direction:column}.panel-title strong{font-size:.83rem}.panel-title>span{font-size:.67rem;color:#64748b}.status-stack{height:18px;border-radius:999px;overflow:hidden;display:flex;margin:18px 0 12px;background:#e7edf4}.status-stack i{display:block;height:100%}.status-stack .s-ready{width:79%;background:#315b85}.status-stack .s-review{width:14%;background:#9eb7d1}.status-stack .s-missing{width:7%;background:#dbe4ed}.status-legend{display:flex;gap:18px;flex-wrap:wrap}.status-legend span{display:flex;align-items:center;gap:6px;font-size:.7rem;color:#526071}.status-legend b{color:#14273d}.dot{width:7px;height:7px;border-radius:50%;display:inline-block}.dot.ready{background:#315b85}.dot.review{background:#9eb7d1}.dot.missing{background:#dbe4ed;border:1px solid #9aa9b7}.rule-badge{padding:4px 8px!important;background:#eef4fb;border-radius:999px;color:#31557f!important;font-weight:750}.rule-list{margin-top:10px}.rule-list p{display:flex;justify-content:space-between;margin:0;padding:8px 0;border-top:1px solid #edf1f5;font-size:.73rem}.rule-list p:first-child{border-top:0}.rule-list b{color:#294c70}.ap-table-panel{margin-top:10px}.ap-table{margin-top:11px;border-top:1px solid #e1e8ef}.ap-row{display:grid;grid-template-columns:1.2fr .8fr .65fr .8fr .65fr;gap:8px;padding:9px 6px;border-bottom:1px solid #edf1f5;font-size:.68rem;color:#405165}.ap-row.ap-head{font-weight:750;color:#657789;background:#f8fafc}.ap-row.selected{background:#f2f6fb}.ap-row em{font-style:normal;font-weight: